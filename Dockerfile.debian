ARG BASE_IMAGE=debian:unstable-slim
ARG SSL=openssl

# Build and test with all SSL backends

FROM ${BASE_IMAGE} AS build

ARG BUILD_TYPE=Release
ARG SHMEM=true
ARG DEBIAN_FRONTEND=noninteractive

RUN \
	apt-get update && \
	apt-get install -qq -y --no-install-recommends \
		build-essential \
		ca-certificates \
		cmake \
		git \
		pkg-config \
		libconfig-dev \
		libprotobuf-c-dev \
		libgnutls28-dev \
		libmbedtls-dev \
		libssl-dev && \
	rm -rf /var/lib/apt/lists/*

WORKDIR /umurmur

COPY CMakeLists.txt .
COPY cmake cmake
COPY umurmur.conf.example .
COPY src src

RUN \
	for s in mbedtls openssl gnutls; do \
		cmake -B "build-${s}" \
			-DSSL="${s}" \
			-DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
			-DUSE_SHAREDMEMORY_API="${SHMEM}" && \
		cmake --build "build-${s}" && \
		ctest --test-dir "build-${s}" --output-on-failure; \
	done

# Runtime images

FROM ${BASE_IMAGE} AS runtime-openssl
ARG DEBIAN_FRONTEND=noninteractive
RUN \
	apt-get update && \
	apt-get install -qq -y --no-install-recommends \
		libconfig11 \
		libprotobuf-c1 \
		libssl3t64 && \
	rm -rf /var/lib/apt/lists/* && \
	mkdir -p /etc/umurmur /usr/local/etc/umurmur
COPY --from=build /umurmur/build-openssl/src/umurmurd /usr/local/bin/
COPY --from=build /umurmur/umurmur.conf.example /usr/local/etc/umurmur/umurmur.conf
EXPOSE 64738/tcp 64738/udp
ENTRYPOINT ["/usr/local/bin/umurmurd", "-d"]

FROM ${BASE_IMAGE} AS runtime-mbedtls
ARG DEBIAN_FRONTEND=noninteractive
RUN \
	apt-get update && \
	apt-get install -qq -y --no-install-recommends \
		libconfig11 \
		libprotobuf-c1 \
		libmbedtls21 \
		libmbedx509-7 \
		libmbedcrypto16 && \
	rm -rf /var/lib/apt/lists/* && \
	mkdir -p /etc/umurmur /usr/local/etc/umurmur
COPY --from=build /umurmur/build-mbedtls/src/umurmurd /usr/local/bin/
COPY --from=build /umurmur/umurmur.conf.example /usr/local/etc/umurmur/umurmur.conf
EXPOSE 64738/tcp 64738/udp
ENTRYPOINT ["/usr/local/bin/umurmurd", "-d"]

FROM ${BASE_IMAGE} AS runtime-gnutls
ARG DEBIAN_FRONTEND=noninteractive
RUN \
	apt-get update && \
	apt-get install -qq -y --no-install-recommends \
		libconfig11 \
		libprotobuf-c1 \
		libgnutls30t64 && \
	rm -rf /var/lib/apt/lists/* && \
	mkdir -p /etc/umurmur /usr/local/etc/umurmur
COPY --from=build /umurmur/build-gnutls/src/umurmurd /usr/local/bin/
COPY --from=build /umurmur/umurmur.conf.example /usr/local/etc/umurmur/umurmur.conf
EXPOSE 64738/tcp 64738/udp
ENTRYPOINT ["/usr/local/bin/umurmurd", "-d"]

# Default public image: --build-arg SSL=openssl|mbedtls|gnutls
FROM runtime-${SSL}
